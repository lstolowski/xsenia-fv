# Copy to keystore.properties (ignored by git) and fill in values — see README.md, "Wydanie APK".
# storeFile is relative to the project root.
storeFile=secrets/xsenia-release.jks
keyAlias=xsenia
# Passwords may be left empty here and given as environment variables
# XSENIA_STORE_PASSWORD / XSENIA_KEY_PASSWORD. For a PKCS12 keystore keyPassword = storePassword.
storePassword=
keyPassword=
